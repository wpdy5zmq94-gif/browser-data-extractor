{
  "manifest_version": 3,
  "name": "Browser Data Extractor",
  "version": "1.0.0",
  "description": "Extract data from a page you already have open. Includes an AliExpress wishlist to CSV adapter.",
  "homepage_url": "https://github.com/wpdy5zmq94-gif/browser-data-extractor",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "downloads", "activeTab"],
  "host_permissions": [
    "https://*.aliexpress.com/*",
    "https://aliexpress.com/*"
  ],
  "action": {
    "default_title": "Browser Data Extractor",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.aliexpress.com/*",
        "https://aliexpress.com/*"
      ],
      "js": ["content/content.js"],
      "type": "module",
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
